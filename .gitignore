# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.venv/
env/

# --- OS ---
.DS_Store

# --- Reference papers (copyrighted — keep local, do not publish) ---
pdfs/

# --- Superseded / buggy notebook kept only for local reference ---
old_notebooks/

# --- Raw / large datasets (contents of data/ ignored; demo samples re-included below) ---
data/*

# --- Stray archives / logs / loose weights / arrays ---
*.zip
*.tar.gz
*.log
*.h5
*.hdf5
*.npy

# --- Keep the committed demo inputs (MUST come after the broad ignores above) ---
!data/samples/
!data/samples/sample_adr_readings.json
!data/samples/*.npy

# NOTE: model artifacts under models/ (*.keras, *.pt, *.pkl) are intentionally
# tracked so the demo can run. Keep them small; retrain via notebooks/ if large.
